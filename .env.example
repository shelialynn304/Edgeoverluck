# Required: paid vision API
ANTHROPIC_API_KEY=

# Required in deployed environments: Upstash Redis REST credentials.
# Use the standard read/write token, never the read-only token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional but recommended: Cloudflare Turnstile.
# Configure both values together or leave both empty.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=edgeoverluck.com, www.edgeoverluck.co.
TURNSTILE_EXPECTED_ACTION=scan_odds

# Allowed browser origins, comma-separated.
SCAN_ALLOWED_ORIGINS=https://edgeoverluck.com,https://www.edgeoverluck.com

# Default request and quota limits.
SCAN_RATE_LIMIT_PER_MINUTE=5
SCAN_RATE_LIMIT_PER_HOUR=20
SCAN_DAILY_IP_QUOTA=40
SCAN_DAILY_GLOBAL_QUOTA=400
SCAN_MAX_IMAGE_BYTES=8388608

# Optional hardening and timeout controls.
SCAN_REQUIRE_ORIGIN=false
SCAN_REDIS_TIMEOUT_MS=2500
TURNSTILE_TIMEOUT_MS=5000
SCAN_SECURITY_FAIL_OPEN=false

# LOCAL DEVELOPMENT ONLY. Never enable this in production.
SCAN_SECURITY_DISABLED=false
